@model List<City>

@{
    string SetBGColor(int temperature)
    {
        if (temperature < 44)
        {
            return "dodgerblue";
        }
        else if (temperature < 74)
        {
            return "green";
        }
        else
        {
            return "orange";
        }
    }
}

<!DOCTYPE html>
<html>
<head>
    <title>City temperatures</title>
    <link href="~/StyleSheet.css" rel="stylesheet" />
</head>
<body>
    <div class="container">
        <div class="page-content">
            <h1>Weather</h1>
            <div class="margin-left">
                <div class="flex">
                    @foreach (City city in Model)
                    {
                        <div class="box cursor-pointer w-30 margin-auto margin-top-200" style="background-color:@SetBGColor(city.TemperatureFahrenheit)">
                            <div class="flex-borderless">
                                <div class="w-50">
                                    <h2>@city.CityName</h2>
                                    <h4 class="text-grey">@city.DateAndTime.ToString("hh:mm tt")</h4>
                                </div>
                                <div class="w-50 border-left">
                                    <h1 class="margin-left">@city.TemperatureFahrenheit <sup class="text-grey">&#8457</sup></h1>
                                    <a href="~/weather/@city.CityUniqueCode" class="margin-top">Details</a>
                                </div>
                            </div>
                        </div>
                    }
               </div>
            </div>            
        </div>
    </div>
</body>
</html>
