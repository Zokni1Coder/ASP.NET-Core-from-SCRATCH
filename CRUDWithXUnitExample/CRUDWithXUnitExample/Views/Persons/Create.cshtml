<a asp-controller="persons" asp-action="index" class="link-hover">Back to Person List</a>
<h1>Create Person</h1>

@if (ViewBag.Errors != null)
{
    @foreach (string error in ViewBag.Errors)
    {
        <div class="alert">
            <span class="closebtn" onclick="this.parentElement.style.display='none';">&times;</span>
            <strong>Attention!</strong> @error
        </div>
    }
}
<div class="w-50">
    <form asp-controller="persons" asp-action="create" method="post">

        @*PersonName*@
        <div class="flex form-field">
            <div class="w-25">
                <label class="form-label pt" for="PersonName">Person Name</label>
            </div>
            <div class="flex-1">
                <input type="text" id="PersonName" name="PersonName" class="form-input" />
            </div>
        </div>


        @*Email*@
        <div class="form-field flex">
            <div class="w-25">
                <label class="form-label pt" for="Email">Email</label>
            </div>
            <div class="flex-1">
                <input type="email" id="Email" name="Email" class="form-input" />
            </div>
        </div>

        @*DateOfBirth*@
        <div class="form-field flex">
            <div class="w-25">
                <label class="form-label pt" for="DateofBirth">Date of Birth</label>
            </div>
            <div class="flex-1">
                <input type="date" id="DateofBirth" name="DateofBirth" class="form-input" />
            </div>
        </div>

        @*Gender*@
        <div class="form-field flex">
            <div class="w-25">
                <label class="form-label pt" for="Gender">Gender</label>
            </div>
            <div class="flex-1">
                <input type="radio" class="ml" id="Male" name="Gender" value="Male" />
                <label for="Male" class="form-label">Male</label>
                <input type="radio" class="ml" id="Female" name="Gender" value="Female" />
                <label for="Female" class="form-label">Female</label>
                <input type="radio" class="ml" id="Other" name="Gender" value="Other" />
                <label for="Other" class="form-label">Other</label>
            </div>
        </div>
        @*Country*@
        <div class="flex form-field">
            <div class="w-25">
                <label class="form-label pt" for="CountryId">Country</label>
                <div class="flex-1">
                    <select class="form-input" id="CountryId" name="CountryId">
                        <option value="">Please Select</option>
                        @foreach (CountryResponse country in ViewBag.Countries)
                        {
                            <option value="@country.CountryID">@country.Name</option>
                        }
                    </select>
                </div>
            </div>
        </div>
        @*Address*@
        <div class="flex form-field">
            <div class="w-25">
                <label class="form-label pt" for="Address">Address</label>
            </div>
            <div class="flex-1">
                <textarea id="Address" name="Address" class="form-input"></textarea>
            </div>
        </div>

        @*ReceiveNewsLetter*@
        <div class="flex form-field">
            <div class="w-25">
            </div>
            <div class="flex-1">
                <input type="checkbox" name="ReceiveNewsLetter" id="ReceiveNewsLetter" value="true" />
                <label for="ReceiveNewsLetter" class="form-label">Receive News Letter</label>
            </div>
        </div>
        <button type="submit" class="button button-green-back">Submit</button>
    </form>
</div>