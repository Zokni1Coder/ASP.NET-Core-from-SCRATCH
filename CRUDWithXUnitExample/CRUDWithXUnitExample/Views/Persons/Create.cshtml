@model PersonAddRequest //Ha asp-for", akkor strongly typed //

<a asp-controller="persons" asp-action="index" class="link-hover">Back to Person List</a>
<h1>Create Person</h1>

@if (ViewBag.Errors != null)
{
    @foreach (string error in ViewBag.Errors)
    {
        <div class="alert">
            <span class="closebtn" onclick="this.parentElement.style.display='none';">&times;</span>
            <strong>Attention!</strong> @error
        </div>
    }
}
<div class="w-50">
    <form asp-controller="persons" asp-action="create" method="post">

        @*PersonName*@
        <div class="flex form-field">
            <div class="w-25">
                <label class="form-label pt" asp-for="PersonName"></label>
            </div>
            <div class="flex-1">
                <input asp-for="PersonName" class="form-input" />
            </div>
        </div>


        @*Email*@
        <div class="form-field flex">
            <div class="w-25">
                <label class="form-label pt" asp-for="Email"></label>
            </div>
            <div class="flex-1">
                <input asp-for="Email" class="form-input" />
            </div>
        </div>

        @*DateOfBirth*@
        <div class="form-field flex">
            <div class="w-25">
                <label class="form-label pt" asp-for="DateOfBirth"></label>
            </div>
            <div class="flex-1">
                <input asp-for="DateOfBirth" class="form-input" />
            </div>
        </div>

        @*Gender*@
        <div class="form-field flex">
            <div class="w-25">
                <label class="form-label pt" asp-for="Gender"></label>
            </div>
            <div class="flex-1">
                @foreach (var gender in ViewBag.Genders)
                {
                    <input type="radio" class="ml" asp-for="Gender" value="@gender" />
                    <label for="@gender" class="form-label">@gender</label>
                }
            </div>
        </div>
        @*Country*@
        <div class="flex form-field">
            <div class="w-25">
                <label class="form-label pt" asp-for="CountryId"></label>
                <div class="flex-1">
                    <select class="form-input" asp-for="CountryId">
                        <option value="">Please Select</option>
                        @foreach (CountryResponse country in ViewBag.Countries)
                        {
                            <option value="@country.CountryID">@country.Name</option>
                        }
                    </select>
                </div>
            </div>
        </div>
        @*Address*@
        <div class="flex form-field">
            <div class="w-25">
                <label class="form-label pt" asp-for="Address"></label>
            </div>
            <div class="flex-1">
                <textarea asp-for="Address" class="form-input"></textarea>
            </div>
        </div>

        @*ReceiveNewsLetter*@
        <div class="flex form-field">
            <div class="w-25">
            </div>
            <div class="flex-1">
                <input asp-for="ReceiveNewsLetter" value="true" />
                <label asp-for="ReceiveNewsLetter" class="form-label"></label>
            </div>
        </div>
        <button type="submit" class="button button-green-back">Submit</button>
    </form>
</div>