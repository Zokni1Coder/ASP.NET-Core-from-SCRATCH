@model IEnumerable<PersonResponse>
@{
    ViewBag.Title = "Persons";
}
@if (ViewBag.SuccessfullCreation == true)
{
    <div class="alert">
        <span class="closebtn" onclick="this.parentElement.style.display='none';">&times;</span>
        <strong>Successfull created a Person!</strong>
    </div>
    ViewBag.SuccessfullCreation = false;
}
<form action="~/persons/index" method="get">
    <h1>Persons</h1>
    <div class="box flex">
        <select class="form-input" name="searchBy">
            @foreach (var option in ViewBag.searchByOptions)
            {
                if (ViewBag.activeSearchKey == option.Key)
                {
                    <option value="@option.Key" selected="selected">@option.Value</option>
                }
                else
                {
                    <option value="@option.Key">@option.Value</option>
                }
            }
        </select>
        <input type="search" name="searchString" placeholder="@ViewBag.activeOptionValue" class="form-input" />
        <button type="submit" class="button blue-back">Search</button>
        <a href="/" class="link-hover">Clear all</a>
    </div>
    <table class="table w-100 margin-top">
        <thead>
            <tr>
                @foreach (var item in ViewBag.TableColumnHeaders)
                {
                    <partial name="_TableColumnHeader" model="item" />
                }
            </tr>
        </thead>
        <tbody>
            @foreach (PersonResponse person in Model)
            {
                <tr>
                    <td>@person.PersonName</td>
                    <td>@person.Email</td>
                    <td>@person.DateOfBirth?.ToString("dd MMM yyyy")</td>
                    <td>@person.Age</td>
                    <td>@person.Gender</td>
                    <td>@person.Country</td>
                    <td>@person.Address</td>
                    <td>@person.ReceiveNewsLetter</td>
                </tr>
            }
        </tbody>
    </table>
</form>