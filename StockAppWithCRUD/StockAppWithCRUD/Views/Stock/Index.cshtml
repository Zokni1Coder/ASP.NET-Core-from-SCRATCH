@model StockViewModel

<form method="post">
    <div class="box">
        <div class="flex w-50">
            <h1 class="text-green">
                @Model.Name
            </h1>
            <h2>
                <span class="text-grey">$</span> @Model.Price
            </h2>
        </div>
        <div class="flex w-50">              
            <h4>New Order</h4>

            <input type="text" name="shares" />
            <input type="hidden" name="companyName" value="@ViewBag.Profile["name"]" />
            <input type="hidden" name="price" value="@ViewBag.Quote["c"]" />
            <button type="submit" formaction="/trade/sellorder" class="green-back">&#8595 Sell</button>
            <button type="submit" formaction="/trade/buyorder" class="blue-back">&#8593 Buy</button>

        </div>
    </div>
</form>