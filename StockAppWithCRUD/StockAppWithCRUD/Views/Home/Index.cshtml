<div class="box">
    <div class="flex w-50">
        <h1 class="text-green">
            @ViewBag.profile["name"] (@ViewBag.profile["ticker"])
        </h1>
        <h2>
            <span class="text-grey">$</span> @ViewBag.quotes["c"]
        </h2>
    </div>
    <div class="flex w-50">
        <h4>New Order</h4>
        <form method="post" action="">
            <input type="text" name="" />
            <button type="submit" class="green-back">&#8595 Sell</button>
            <button type="submit" class="blue-back">&#8593 Buy</button>
        </form>
    </div>
</div>