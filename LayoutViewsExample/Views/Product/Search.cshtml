@{
    //Layout = "~/Views/Shared/_Layout.cshtml";

    //Az elnevezési konvenció Layout/ViewStart/ViewImport esetén: "_"-vel kezdődik.

    //Célunk az, hogy kizárólag a Search View-an legyen más a sablonunk.

    //Ha kapunk egy productID-t az urlben akkor az egyedi Layout fog lefutni, különben
    //a Shared-ben lévő általános. 
    if (ViewBag.ProductID != null)
    {
        Layout = "~/Views/Shared/_ProductLayout.cshtml";
    }
    ViewBag.Title = "Search";
}

