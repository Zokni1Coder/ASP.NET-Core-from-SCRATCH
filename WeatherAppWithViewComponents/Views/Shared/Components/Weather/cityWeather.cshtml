@model City
@{
    string SetBGColor(int temperature)
    {
        if (temperature < 44)
        {
            return "dodgerblue";
        }
        else if (temperature < 74)
        {
            return "green";
        }
        else
        {
            return "orange";
        }
    }
}

<div class="box cursor-pointer w-30 margin-auto margin-top-200" style="background-color:@SetBGColor(Model.TemperatureFahrenheit)">
    <div class="flex-borderless">
        <div class="w-50">
            <h2>@Model.CityName</h2>
            <h4 class="text-grey">@Model.DateAndTime.ToString("hh:mm tt")</h4>
        </div>
        <div class="w-50 border-left">
            <h1 class="margin-left">@Model.TemperatureFahrenheit <sup class="text-grey">&#8457</sup></h1>
            <a href="~/weather/@Model.CityUniqueCode" class="margin-top">Details</a>
        </div>
    </div>
</div>