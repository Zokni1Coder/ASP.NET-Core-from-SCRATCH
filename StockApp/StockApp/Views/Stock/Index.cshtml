@model StockTrade
<form method="post">
    <div class="box">
        <div class="flex w-50">
            <div class="flex-1">
                <h1 class="text-green">
                    @Model.stockName (@Model.stockSymbol)
                </h1>
            </div>
            <div class="flex-1">
                <h1>
                    <span class="text-grey">$</span> @Model.price
                </h1>
            </div>
            <div class="flex-1">
                <h1>
                    <span class="text-grey">$</span> @Model.price
                </h1>
            </div>
        </div>
        <div class="flex w-50">              
            <h4>New Order</h4>

            <input type="text" name="shares" />
            <input type="hidden" asp-for="stockName" />
            <input type="hidden" asp-for="stockSymbol"/>
            <input type="hidden" asp-for="price" />
            <button formaction="~/Trade/SellOrder" type="submit" class="green-back">&#8595 Sell</button>
            <button type="submit" formaction="~/Trade/BuyOrder" class="blue-back">&#8593 Buy</button>

        </div>
    </div>
</form>