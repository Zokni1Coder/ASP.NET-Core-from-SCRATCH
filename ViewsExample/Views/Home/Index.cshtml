@using ViewsExample.Models

@{
    string title = "Home - From c# block";
    Person person = new Person()
    {
        DateOfBirth = null,
        //DateOfBirth = Convert.ToDateTime("2005-05-18"),
        Name = "Réka",
        Gender = Gender.female //így adod meg az enumot.
    };
}

<!DOCTYPE html>
<html>
<head>
    <title>@title</title>
    <meta charset="utf-8" />
</head>
<body>
    Welcome
    <br />
    <b>Person Object - Name: @person.Name, Birth date: @person.DateOfBirth</b>
    <br />
    @{
        if (person.DateOfBirth.HasValue)
        {
            //A Person osztály DatofBirth mezője nullable lett.
            //Ezért kell a "Value.TotalDays" és nem csak a "TotalDays".
            double age = Math.Round((DateTime.Now - person.DateOfBirth).Value.TotalDays / 365);
            <b>@person.Name is @age year old.</b>
        }
        else
        {
            <b>Unknown the age of @person.Name.</b>
        }
    }
    <br />
    @switch (person.Gender)
    {
        case Gender.female:
            if (person.Name == "Réka")
            {
                <b>Réka persze hogy nő.</b>
            }
            else
            {
                <b>@person.Name is a female.</b>
            }
            break;
        case Gender.male:
            <b>@person.Name is a male.</b>
            break;
        default:
            <b>What is your Gender?</b>
            break;
    }
    <h1>Magyarázat:</h1>
    <b>Namespace importálása:</b>
    <a>
        "@@using ViewsExample.Models
    </a>< br />
    <b>A "@@" jel írása egyszerű szövegként dupla kukac.</b>
    <br />
    <br />
    <b>A Kód blokkban található a kiírt Person Objektum.</b>
    <br />
    <br />
    <b>A szöveg, ami kiírja az objektumunk értékeit, abban vannak az expression-ök. Pl: "@@person.Name"</b>
</body>
</html>
