@using ViewsExample.Models

@{
    //string title = "Home - From c# block";
    // Person person = new Person()
    // {
    //     //DateOfBirth = null,
    //     DateOfBirth = Convert.ToDateTime("2005-05-18"),
    //     Name = "Réka",
    //     Gender = Gender.female, //így adod meg az enumot.
    //     FavoriteCities = new List<string> { "Szabadka", "Salzburg", "Eger", "Rimini" }
    // };

    //Mivel a ViewData egy key-value pár típusú, nekünk viszont objektum van átadva,
    // ezért castolni kell.
    Person person = (Person)ViewData["person"];

    //string alertMessage = $"<script>alert('{person.Name}-nak/nek {person.FavoriteCities.Count} kedvenc városa van!')</script>";
}

@{
    double? GetAge(DateTime? dateOfBirth)
    {
        if (dateOfBirth is not null)
        {
            return Math.Round((DateTime.Now - person.DateOfBirth).Value.TotalDays / 365);
        }
        else
        {
            return null;
        }
    }
}

<!DOCTYPE html>
<html>
<head>
    <title>@ViewData["title"]</title>
    <meta charset="utf-8" />
    <link href="~/StyleSheet.css" rel="stylesheet" />
</head>
<body>
    @Html.Raw(ViewData["alertMessage"])
    <div class="page-content">
        Welcome
        <br />
        <b>Person Object - Name: @person.Name, Birth date: @person.DateOfBirth</b>
        <br />
        @{
            if (person.DateOfBirth.HasValue)
            {
                //A Person osztály DatofBirth mezője nullable lett.
                //Ezért kell a "Value.TotalDays" és nem csak a "TotalDays".
                //double age = Math.Round((DateTime.Now - person.DateOfBirth).Value.TotalDays / 365);
                <b>@person.Name is @GetAge(person.DateOfBirth) year old.</b>
            }
            else
            {
                <b>Unknown the age of @person.Name.</b>
            }
        }
        <br />
        @switch (person.Gender)
        {
            case Gender.female:
                if (person.Name == "Réka")
                {
                    <b>Réka persze hogy nő.</b>
                }
                else
                {
                    <b>@person.Name is a female.</b>
                }
                break;
            case Gender.male:
                <b>@person.Name is a male.</b>
                break;
            default:
                <b>What is your Gender?</b>
                break;
        }
        <br />
        <p>A @person.Name kedvenc városai,ahol eddig volt:</p>
        <ul>
            @{
                foreach (var city in person.FavoriteCities)
                {
                    <li>@city</li>
                }
            }
        </ul>
        <p>A @person.Name kedvenc városai,ahol eddig volt táblázattal megadva:</p>
        <table class="table">
            @for (int i = 0; i < 4; i++)
            {
                <tr><td>@i.)</td><td>@person.FavoriteCities[i]</td></tr>
            }
        </table>
        <h1>Magyarázat:</h1>
        <b>Namespace importálása:</b>
        <a>
            "@@using ViewsExample.Models
        </a>
        <br />
        <b>A "@@" jel írása egyszerű szövegként dupla kukac.</b>
        <br />
        <br />
        <b>A Kód blokkban található a később kiírt Person Objektum.</b>
        <br />
        <br />
        <b>A szöveg, ami kiírja az objektumunk értékeit, abban vannak az expression-ök. Pl: "@@person.Name"</b>
    </div>
</body>
</html>
