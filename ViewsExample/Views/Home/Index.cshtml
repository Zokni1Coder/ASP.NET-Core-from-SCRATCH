@using ViewsExample.Models

@{
    string title = "Home - From c# block";
    Person person = new Person()
    {
        DateOfBirth = Convert.ToDateTime("2005-05-18"),
        Name = "Réka"
    };
}

<!DOCTYPE html>
<html>
<head>
    <title>@title</title>
    <meta charset="utf-8" />
</head>
<body>
    Welcome
    <br />
    <b>Person Object - Name: @person.Name, Birth date: @person.DateOfBirth</b>
    @{
        double age = Math.Round((DateTime.Now - person.DateOfBirth).TotalDays / 365);
    }
    <br />
    <b>@person.Name is @age year old.</b>

    <h1>Magyarázat:</h1>
    <b>Namespace importálása:</b>
    <a>
        "@@using ViewsExample.Models</a>< br />
    <b>A "@@" jel írása egyszerű szövegként dupla kukac.</b>
    <br />
    <br />
    <b>A Kód blokkban található a kiírt Person Objektum.</b> 
    <br />
    <br />
    <b>A szöveg, ami kiírja az objektumunk értékeit, abban vannak az expression-ök. Pl: "@@person.Name"</b>
</body>
</html>
